module <%= @module_name %>
<%= declaration_open %>
    <%= build_signature %>
    <% unless dsl_rbs_setters.empty? %>

    <%= dsl_rbs_setters %>
    <% end %>
    <% unless @additional_properties.nil? %>

    <%= extra_signature %>
    <% end %>

    <%= to_h_signature %>

    private

    <%= fields_signature %>

    <%= builder_class %>
<%= declaration_close %>
end

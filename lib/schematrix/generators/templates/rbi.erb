# typed: strict

module <%= @module_name %>
<%= declaration_open %>
    <% unless @property_keys.empty? %>
    <%= original_keys_constant %>

    <% end %>    sig { <%= sorbet_constructor_signature_params %>void }
    def initialize<%= constructor_arguments %>; end

    <%= sorbet_attr_accessors %>
    <% unless @additional_properties.nil? %>

    sig { params(key: String).returns(<%= sorbet_additional_properties_type %>) }
    def [](key); end
    <% unless immutable? %>

    sig { params(key: String, value: <%= sorbet_additional_properties_type %>).returns(<%= sorbet_additional_properties_type %>) }
    def []=(key, value); end
    <% end %>
    <% end %>
    <% if immutable? %>

    <%= sorbet_with_signature %>
    def with(<%= rbi_with_parameters %>); end

    <%= sorbet_equality_signature %>
    def ==(other); end

    alias eql? ==

    <%= sorbet_hash_signature %>
    def hash; end
    <% end %>
<% if conversions? %>
<% if spec_uses_class_slot? %>

    <%= sorbet_coercion_helper_signature %>
    def self.coerce_class_slot(value, klass); end
<% end %>
<% if interpreter? %>

    <%= sorbet_spec_helper_signature %>
    def self.coerce_spec(value, spec); end
<% end %>
<% end %>
<% if catch_all_spec %>

    <%= sorbet_coercion_signature %>
    def self.coerce_extra(value); end
<% end %>
<% property_coercions.each do |name, plan| %>
<% next if plan.nil? %>

    <%= sorbet_coercion_signature %>
    def self.coerce_<%= name %>(value); end
<% end %>

    <%= sorbet_from_h_signature %>
    def self.from_h(hash); end

    <%= sorbet_to_h_signature %>
    def to_h; end
    <% if immutable? && !@additional_properties.nil? %>

    protected

    <%= sorbet_extra_reader_signature %>
    def _extra; end
    <% end %>
<%= declaration_close %>
<% coercer_block = coercer_modules_block(sig: sorbet_coercion_signature, requires: false, stub: true) %>
<% unless coercer_block.empty? %>

<%= coercer_block %>
<% end %>
end

# typed: strict

module <%= @module_name %>
<%= declaration_open %>
    <% unless @property_keys.empty? %>
    <%= original_keys_constant %>

    <% end %>    sig { <%= sorbet_constructor_signature_params %>void }
    def initialize<%= constructor_arguments %>; end

    <%= sorbet_attr_accessors %>
    <% unless @additional_properties.nil? %>

    sig { params(key: String).returns(<%= sorbet_additional_properties_type %>) }
    def [](key); end

    sig { params(key: String, value: <%= sorbet_additional_properties_type %>).returns(<%= sorbet_additional_properties_type %>) }
    def []=(key, value); end
    <% end %>
<% property_coercions.each do |name, plan| %>
<% next if plan.nil? %>

    <%= sorbet_coercion_signature %>
    def self.coerce_<%= name %>(value); end
<% end %>

    <%= sorbet_from_h_signature %>
    def self.from_h(hash); end

    <%= sorbet_to_h_signature %>
    def to_h; end
<%= declaration_close %>
end

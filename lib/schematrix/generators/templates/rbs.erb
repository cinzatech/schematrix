module <%= @module_name %>
<%= declaration_open %>
    <%= rbs_attr_accessors %>

    def initialize: (
      <%= rbs_initialize_params %>
    ) -> void
    <% unless @additional_properties.nil? %>

    def []: (String) -> <%= rbs_additional_properties_type %>

    def []=: (String, <%= rbs_additional_properties_type %>) -> <%= rbs_additional_properties_type %>
    <% end %>

    def self.from_h: (Hash[String, <%= untyped %>] hash) -> <%= own_class_name %>

    def to_h: () -> Hash[String, <%= untyped %>]
<%= declaration_close %>
end

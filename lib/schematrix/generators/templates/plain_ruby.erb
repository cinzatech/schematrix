module <%= @module_name %>
<%= declaration_open %>
    def initialize<%= constructor_arguments %>
      <%= constructor_assignments %>
      <% unless @additional_properties.nil? %>
      @_extra = {}
      <% end %>
    end

    <%= plain_attr_accessor_line %>
    <% unless @additional_properties.nil? %>

    def [](key)
      @_extra[key]
    end

    def []=(key, value)
      @_extra[key] = value
    end
    <% end %>
<%= declaration_close %>
end

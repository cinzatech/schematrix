module <%= @module_name %>
<%= declaration_open %>
    <% unless @property_keys.empty? %>
    <%= original_keys_constant %>

    <% end %>    def initialize<%= constructor_arguments %>
      <%= constructor_assignments %>
      <% unless @additional_properties.nil? %>
      @_extra = {}
      <% end %>
    end

    <%= plain_attr_accessor_line %>
    <% unless @additional_properties.nil? %>

    def [](key)
      @_extra[key]
    end

    def []=(key, value)
      @_extra[key] = value
    end
    <% end %>
<% property_coercions.each do |name, plan| %>
<% next if plan.nil? %>

    <%= coercion_method_body(name, plan) %>
<% end %>

    <%= from_h_method %>

    <%= to_h_method %>
<%= declaration_close %>
end

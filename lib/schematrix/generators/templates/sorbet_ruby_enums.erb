# typed: strict
<% if uses_coercion_helper? %>

<%= coercion_helper_require %>
<% end %>

module <%= @module_name %>
<%= declaration_open %>
    extend ::T::Sig
    enums do
<% @members.each do |name, value| -%>
      <%= name %> = new(<%= format_conversion(value.inspect) %>)
<% end -%>
    end

    sig { params(value: ::T.anything).returns(::T.anything) }
    def self.coerce(value)
      <%= coerce_body %>
    end
<%= declaration_close %>
end

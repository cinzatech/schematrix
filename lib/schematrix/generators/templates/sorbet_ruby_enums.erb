# typed: strict

module <%= @module_name %>
<% coercer_block = coercer_modules_block(sig: "sig { params(value: T.anything).returns(T.anything) }") %>
<% unless coercer_block.empty? %>
<%= coercer_block %>

<% end %>
<%= declaration_open %>
    extend ::T::Sig
    enums do
<% @members.each do |name, value| -%>
      <%= name %> = new(<%= format_conversion(value.inspect) %>)
<% end -%>
    end

    sig { params(value: ::T.anything).returns(::T.anything) }
    def self.coerce(value)
      <%= coerce_body %>
    end
<%= declaration_close %>
end

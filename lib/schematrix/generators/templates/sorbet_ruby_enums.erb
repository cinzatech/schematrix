# typed: strict

module <%= @module_name %>
<%= declaration_open %>
    extend ::T::Sig
    enums do
<% @members.each do |name, value| -%>
      <%= name %> = new(<%= value.inspect %>)
<% end -%>
    end

    sig { params(value: ::T.anything).returns(::T.anything) }
    def self.coerce(value)
      <%= coerce_body %>
    end
<%= declaration_close %>
end

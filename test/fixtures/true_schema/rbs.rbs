module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor value: top

    def initialize: (?value: top) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_reader first_name: String
    attr_reader last_name: String
    attr_reader age: Integer?
    attr_reader color: String?

    def initialize: (
      first_name: String,
      last_name: String,
      ?age: Integer?,
      ?color: String?,
      ?_extra: Hash[String, top]
    ) -> void

    def []: (String) -> top

    def with: (
      ?first_name: String,
      ?last_name: String,
      ?age: Integer?,
      ?color: String?,
      ?_extra: Hash[String, top]
    ) -> instance

    def ==: (top other) -> bool

    def hash: -> Integer

    def _extra: -> Hash[String, top]

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

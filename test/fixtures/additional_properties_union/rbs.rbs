module M
  class Schema
    attr_accessor name: String?
    attr_accessor code: String?

    def initialize: (?name: String?, ?code: String?) -> void

    def []: (String) -> Numeric?

    def []=: (String, Numeric?) -> Numeric?

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

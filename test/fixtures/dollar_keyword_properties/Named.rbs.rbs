module M
  class Schema
    module Defs
      class Named
        attr_accessor tag: String?

        def initialize: (?tag: String?) -> void

        def []: (String) -> top

        def []=: (String, top) -> top

        def self.from_h: (Hash[String, top] hash) -> Named

        def to_h: -> Hash[String, top]
      end
    end
  end
end

module M
  class Schema
    attr_accessor id: String?
    attr_accessor if_: String?
    attr_accessor then_: Integer?
    attr_accessor defs: Schema::Props::Defs?
    attr_accessor named: Schema::Defs::Named?

    def initialize: (
      ?id: String?,
      ?if_: String?,
      ?then_: Integer?,
      ?defs: Schema::Props::Defs?,
      ?named: Schema::Defs::Named?
    ) -> void

    def []: (Symbol) -> untyped

    def []=: (Symbol, untyped) -> untyped
  end
end

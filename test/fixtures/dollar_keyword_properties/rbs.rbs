module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor id: String?
    attr_accessor if_: String?
    attr_accessor then_: Integer?
    attr_accessor defs: Schema::Props::Defs?
    attr_accessor named: Schema::Defs::Named?

    def initialize: (
      ?id: String?,
      ?if_: String?,
      ?then_: Integer?,
      ?defs: Schema::Props::Defs?,
      ?named: Schema::Defs::Named?
    ) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.coerce_class_slot: (top value, top klass) -> top

    def self.coerce_array_slot: (top value, top klass) -> top

    def self.coerce_map_slot: (top value, top klass) -> top

    def self.coerce_defs: (top value) -> top

    def self.coerce_named: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

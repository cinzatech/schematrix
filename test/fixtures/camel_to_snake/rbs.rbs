module M
  class Schema
    attr_accessor first_name: String?
    attr_accessor last_name: String?

    def initialize: (?first_name: String?, ?last_name: String?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

module M
  class Schema
    attr_accessor shipping_address: Address?
    attr_accessor billing_address: PostalAddress?
    attr_accessor contact: Address::Props::Zip?
    attr_accessor email: String?

    def initialize: (
      ?shipping_address: Address?,
      ?billing_address: PostalAddress?,
      ?contact: Address::Props::Zip?,
      ?email: String?
    ) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

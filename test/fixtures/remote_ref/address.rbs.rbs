module M
  class Address
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor street: String?
    attr_accessor zip: Address::Props::Zip?

    def initialize: (?street: String?, ?zip: Address::Props::Zip?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.coerce_class_slot: (top value, top klass) -> top

    def self.coerce_spec: (top value, top spec) -> top

    def self.coerce_zip: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Address

    def to_h: -> Hash[String, top]
  end
end

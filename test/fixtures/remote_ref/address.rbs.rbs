module M
  class Address
    attr_accessor street: String?
    attr_accessor zip: Address::Props::Zip?

    def initialize: (?street: String?, ?zip: Address::Props::Zip?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Address

    def to_h: -> Hash[String, top]
  end
end

module M
  class Schema
    attr_accessor address: Schema::Props::Address?

    def initialize: (?address: Schema::Props::Address?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

module M
  class Schema
    module Props
      class Address
        attr_accessor zip: String & Integer
        attr_accessor country: String?
        attr_accessor street: String?

        def initialize: (
          zip: String & Integer,
          ?country: String?,
          ?street: String?
        ) -> void

        def []: (String) -> top

        def []=: (String, top) -> top

        def self.from_h: (Hash[String, top] hash) -> Address

        def to_h: -> Hash[String, top]
      end
    end
  end
end

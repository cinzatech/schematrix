module M
  module Schema
    module Props
      class Address
        attr_accessor zip: String & Integer
        attr_accessor country: String?
        attr_accessor street: String?

        def initialize: (
          zip: String & Integer,
          ?country: String?,
          ?street: String?
        ) -> void

        def []: (Symbol) -> top

        def []=: (Symbol, top) -> top
      end
    end
  end
end

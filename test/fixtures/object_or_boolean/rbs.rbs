module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor meta: (Schema::Props::Meta | bool)?

    def initialize: (?meta: (Schema::Props::Meta | bool)?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.coerce_meta: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor log: Array[Time]?
    attr_accessor window: Array[(Date | Time)]?
    attr_accessor rates: Hash[String, Time]?
    attr_accessor milestone: (Date | Integer)?
    attr_accessor amount: (Time | Schema::Defs::Money)?

    def initialize: (
      ?log: Array[Time]?,
      ?window: Array[(Date | Time)]?,
      ?rates: Hash[String, Time]?,
      ?milestone: (Date | Integer)?,
      ?amount: (Time | Schema::Defs::Money)?
    ) -> void

    def []: (String) -> Date?

    def []=: (String, Date?) -> Date?

    def self.coerce_class_slot: (top value, top klass) -> top

    def self.coerce_spec: (top value, top spec) -> top

    def self.coerce_extra: (top value) -> top

    def self.coerce_log: (top value) -> top

    def self.coerce_window: (top value) -> top

    def self.coerce_rates: (top value) -> top

    def self.coerce_milestone: (top value) -> top

    def self.coerce_amount: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

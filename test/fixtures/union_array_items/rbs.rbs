module M
  class Schema
    attr_accessor tags: Array[(String | Integer)]?

    def initialize: (?tags: Array[(String | Integer)]?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

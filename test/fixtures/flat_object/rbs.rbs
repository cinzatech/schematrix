module M
  class Schema
    attr_accessor name: String?
    attr_accessor age: Integer?
    attr_accessor active: bool?

    def initialize: (?name: String?, ?age: Integer?, ?active: bool?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

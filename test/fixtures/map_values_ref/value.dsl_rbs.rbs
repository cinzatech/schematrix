module M
  module Dsl
    module Schema
      module Defs
        module Value
          def self.build: { -> void } -> Hash[String, top]

          def v: (String value) -> instance

          def extra: (String key, top value) -> instance

          def to_h: -> Hash[String, top]

          private

          def dsl_fields: -> Hash[String, top]

          class Builder
            include Value
          end
        end
      end
    end
  end
end

module M
  class Schema
    attr_accessor vars: Hash[String, Schema::Defs::Value]?

    def initialize: (?vars: Hash[String, Schema::Defs::Value]?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

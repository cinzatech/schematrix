module M
  module Dsl
    module Schema
      def self.build: { -> void } -> Hash[String, top]

      def vars: (String key) { -> void } -> instance

      def extra: (String key, top value) -> instance

      def to_h: -> Hash[String, top]

      private

      def dsl_fields: -> Hash[String, top]

      class Builder
        include Schema
      end
    end
  end
end

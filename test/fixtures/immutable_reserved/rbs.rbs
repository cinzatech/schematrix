module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_reader with_: String
    attr_reader _extra_: Integer?
    attr_reader count: Integer?

    def initialize: (
      with_: String,
      ?_extra_: Integer?,
      ?count: Integer?
    ) -> void

    def with: (?with_: String, ?_extra_: Integer?, ?count: Integer?) -> instance

    def ==: (top other) -> bool

    def hash: -> Integer

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

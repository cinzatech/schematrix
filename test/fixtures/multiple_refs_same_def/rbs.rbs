    attr_accessor work: Schema::Defs::Address?

    def initialize: (
      ?home: Schema::Defs::Address?,
      ?work: Schema::Defs::Address?
    ) -> void

    def []: (Symbol) -> top

    def []=: (Symbol, top) -> top
  end
end

module M
  class Schema
    attr_accessor home: Schema::Defs::Address?
    attr_accessor work: Schema::Defs::Address?

    def initialize: (
      ?home: Schema::Defs::Address?,
      ?work: Schema::Defs::Address?
    ) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

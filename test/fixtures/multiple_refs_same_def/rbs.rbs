module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor home: Schema::Defs::Address?
    attr_accessor work: Schema::Defs::Address?

    def initialize: (
      ?home: Schema::Defs::Address?,
      ?work: Schema::Defs::Address?
    ) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.coerce_class_slot: (top value, top klass) -> top

    def self.coerce_array_slot: (top value, top klass) -> top

    def self.coerce_map_slot: (top value, top klass) -> top

    def self.coerce_home: (top value) -> top

    def self.coerce_work: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

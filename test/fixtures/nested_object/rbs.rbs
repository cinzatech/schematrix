module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor child: Schema::Props::Child?

    def initialize: (?child: Schema::Props::Child?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.coerce_class_slot: (top value, top klass) -> top

    def self.coerce_array_slot: (top value, top klass) -> top

    def self.coerce_map_slot: (top value, top klass) -> top

    def self.coerce_child: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

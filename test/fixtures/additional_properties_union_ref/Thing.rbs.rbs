module M
  class Schema
    module Defs
      class Thing
        attr_accessor name: String?

        def initialize: (?name: String?) -> void

        def []: (String) -> top

        def []=: (String, top) -> top

        def self.from_h: (Hash[String, top] hash) -> Thing

        def to_h: -> Hash[String, top]
      end
    end
  end
end

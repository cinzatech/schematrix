module M
  class Schema
    attr_accessor always: bool?

    def initialize: (?always: bool?) -> void

    def []: (String) -> (String | Schema::Defs::Thing)?

    def []=: (
      String,
      (String | Schema::Defs::Thing)?
    ) -> (String | Schema::Defs::Thing)?

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

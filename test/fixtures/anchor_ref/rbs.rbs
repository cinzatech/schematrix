module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor owner: Schema::Defs::Named?

    def initialize: (?owner: Schema::Defs::Named?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.coerce_owner: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

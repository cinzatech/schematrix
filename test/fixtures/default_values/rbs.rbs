module M
  class Schema
    attr_accessor color: String?
    attr_accessor count: Integer?

    def initialize: (?color: String?, ?count: Integer?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor first_name: Schema::Props::FirstName?
    attr_accessor a_b: Schema::Props::AB?

    def initialize: (
      ?first_name: Schema::Props::FirstName?,
      ?a_b: Schema::Props::AB?
    ) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.coerce_class_slot: (top value, top klass) -> top

    def self.coerce_array_slot: (top value, top klass) -> top

    def self.coerce_map_slot: (top value, top klass) -> top

    def self.coerce_first_name: (top value) -> top

    def self.coerce_a_b: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

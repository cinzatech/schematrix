module M
  class Schema
    attr_accessor str: String?
    attr_accessor refonly: Schema::Defs::Base?
    attr_accessor both: Schema::Defs::Base?
    attr_accessor typed: Schema::Props::Typed?

    def initialize: (
      ?str: String?,
      ?refonly: Schema::Defs::Base?,
      ?both: Schema::Defs::Base?,
      ?typed: Schema::Props::Typed?
    ) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

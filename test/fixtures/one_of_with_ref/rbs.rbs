module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor value: (Schema::Defs::Named | String)?

    def initialize: (?value: (Schema::Defs::Named | String)?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.coerce_value: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

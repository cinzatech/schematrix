module M
  class Schema
    attr_accessor name: String
    attr_accessor email: String
    attr_accessor age: Integer?

    def initialize: (name: String, email: String, ?age: Integer?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

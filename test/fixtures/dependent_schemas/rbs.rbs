module M
  class Schema
    attr_accessor name: String?
    attr_accessor credit_card: String?
    attr_accessor billing_address: String?

    def initialize: (
      ?name: String?,
      ?credit_card: String?,
      ?billing_address: String?
    ) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

module M
  class Schema
    attr_accessor name: String?
    attr_accessor credit_card: String?
    attr_accessor billing_address: String?

    def initialize: (
      ?name: String?,
      ?credit_card: String?,
      ?billing_address: String?
    ) -> void

    def []: (Symbol) -> untyped

    def []=: (Symbol, untyped) -> untyped
  end
end

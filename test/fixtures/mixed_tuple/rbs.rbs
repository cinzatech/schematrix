module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor pair: Array[(String | Schema::Defs::Address)]?

    def initialize: (?pair: Array[(String | Schema::Defs::Address)]?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.coerce_pair: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

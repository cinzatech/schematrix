module M
  module Dsl
    module Schema
      def self.build: { -> void } -> Hash[String, top]

      def created_at: (String value) -> instance

      def birthday: (String value) -> instance

      def email: (String value) -> instance

      def count: (Integer value) -> instance

      def extra: (String key, top value) -> instance

      def to_h: -> Hash[String, top]

      private

      def dsl_fields: -> Hash[String, top]

      class Builder
        include ::M::Dsl::Schema
      end
    end
  end
end

module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor example_com: String?
    attr_accessor web_hook: Schema::Props::WebHook?

    def initialize: (
      ?example_com: String?,
      ?web_hook: Schema::Props::WebHook?
    ) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.coerce_class_slot: (top value, top klass) -> top

    def self.coerce_spec: (top value, top spec) -> top

    def self.coerce_web_hook: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

module M
  class Schema
    attr_accessor value: String?
    attr_accessor children: Array[Schema]?

    def initialize: (?value: String?, ?children: Array[Schema]?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

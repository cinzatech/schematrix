module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor value: String?
    attr_accessor children: Array[Schema]?

    def initialize: (?value: String?, ?children: Array[Schema]?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.coerce_class_slot: (top value, top klass) -> top

    def self.coerce_spec: (top value, top spec) -> top

    def self.coerce_children: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor data: (Integer | bool | String)?

    def initialize: (?data: (Integer | bool | String)?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

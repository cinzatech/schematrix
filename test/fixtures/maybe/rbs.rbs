module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor first_name: String
    attr_accessor age: M::Maybe[Integer?]
    attr_accessor tag: M::Maybe[String?]
    attr_accessor address: M::Maybe[Schema::Props::Address?]
    attr_accessor tags: M::Maybe[Array[String]?]
    attr_accessor labels: M::Maybe[Hash[String, Integer]?]
    attr_accessor nickname: String?
    attr_accessor voids: M::Maybe[Array[nil]?]

    def initialize: (
      first_name: String,
      nickname: String?,
      ?age: M::Maybe[Integer?],
      ?tag: M::Maybe[String?],
      ?address: M::Maybe[Schema::Props::Address?],
      ?tags: M::Maybe[Array[String]?],
      ?labels: M::Maybe[Hash[String, Integer]?],
      ?voids: M::Maybe[Array[nil]?]
    ) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.coerce_address: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor status: ("active" | "inactive")?

    def initialize: (?status: ("active" | "inactive")?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

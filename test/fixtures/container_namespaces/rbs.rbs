module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor home: Schema::Props::Home?
    attr_accessor alt: Schema::Defs::Address?

    def initialize: (
      ?home: Schema::Props::Home?,
      ?alt: Schema::Defs::Address?
    ) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.coerce_class_slot: (top value, top klass) -> top

    def self.coerce_spec: (top value, top spec) -> top

    def self.coerce_home: (top value) -> top

    def self.coerce_alt: (top value) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

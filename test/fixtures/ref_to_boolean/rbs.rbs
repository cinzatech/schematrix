module M
  class Schema
    attr_accessor flag: top
    attr_accessor dead: top
    attr_accessor sibling: String?

    def initialize: (?flag: top, ?dead: top, ?sibling: String?) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end

module M
  class Schema
    module Props
      class Value
        ORIGINAL_KEYS: Hash[String, Symbol]

        attr_accessor name: top
        attr_accessor age: top

        def initialize: (?name: top, ?age: top) -> void

        def []: (String) -> top

        def []=: (String, top) -> top

        def self.from_h: (Hash[String, top] hash) -> Value

        def to_h: -> Hash[String, top]
      end
    end
  end
end

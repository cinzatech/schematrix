module M
  class Schema
    attr_accessor kind: String?
    attr_accessor value: String?
    attr_accessor tier: Integer?
    attr_accessor reason: String?

    def initialize: (
      ?kind: String?,
      ?value: String?,
      ?tier: Integer?,
      ?reason: String?
    ) -> void

    def []: (Symbol) -> top

    def []=: (Symbol, top) -> top
  end
end

module M
  class Schema
    ORIGINAL_KEYS: Hash[String, Symbol]

    attr_accessor kind: String?
    attr_accessor value: String?
    attr_accessor tier: Integer?
    attr_accessor reason: String?

    def initialize: (
      ?kind: String?,
      ?value: String?,
      ?tier: Integer?,
      ?reason: String?
    ) -> void

    def []: (String) -> top

    def []=: (String, top) -> top

    def self.from_h: (Hash[String, top] hash) -> Schema

    def to_h: -> Hash[String, top]
  end
end
